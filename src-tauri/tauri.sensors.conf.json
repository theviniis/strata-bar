{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -File scripts/build-desktop.ps1"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../sensor-service/artifacts/publish/": "sensor-service/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "../sensor-service/artifacts/installer.nsi",
        "installerHooks": "installer/sensors.nsh"
      }
    }
  }
}
