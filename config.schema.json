{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "number", "const": 2 },
    "audio": {
      "default": {
        "output": { "source": "windows", "targetIndex": 0 },
        "input": { "source": "windows", "targetIndex": 0 }
      },
      "type": "object",
      "properties": {
        "output": {
          "default": { "source": "windows", "targetIndex": 0 },
          "type": "object",
          "properties": {
            "source": {
              "default": "windows",
              "type": "string",
              "enum": ["windows", "voicemeeter"]
            },
            "targetIndex": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "additionalProperties": false
        },
        "input": {
          "default": { "source": "windows", "targetIndex": 0 },
          "type": "object",
          "properties": {
            "source": {
              "default": "windows",
              "type": "string",
              "enum": ["windows", "voicemeeter"]
            },
            "targetIndex": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "default": {
        "visible": {
          "chatgpt": true,
          "opencode": true,
          "antigravity": true,
          "codex": true
        }
      },
      "type": "object",
      "properties": {
        "visible": {
          "default": {
            "chatgpt": true,
            "opencode": true,
            "antigravity": true,
            "codex": true
          },
          "type": "object",
          "properties": {
            "chatgpt": { "default": true, "type": "boolean" },
            "opencode": { "default": true, "type": "boolean" },
            "antigravity": { "default": true, "type": "boolean" },
            "codex": { "default": true, "type": "boolean" }
          }
        }
      }
    },
    "bar": {
      "type": "object",
      "properties": {
        "enabled": { "default": true, "type": "boolean" },
        "position": {
          "default": "top",
          "type": "string",
          "enum": ["top", "bottom"]
        },
        "height": {
          "default": 36,
          "type": "integer",
          "minimum": 28,
          "maximum": 80
        },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 40 },
        "spacing": {
          "default": 8,
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "separatorMarginX": { "type": "number", "minimum": 0, "maximum": 32 },
        "theme": {
          "default": "system",
          "type": "string",
          "enum": ["system", "dark", "light"]
        },
        "colorTheme": {
          "default": "current",
          "type": "string",
          "enum": ["current", "amoled", "nord", "dracula", "catppuccin"]
        },
        "alwaysOnTop": { "default": true, "type": "boolean" }
      }
    },
    "widgets": {
      "type": "object",
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": [
                  "separator",
                  "clock",
                  "reminders",
                  "agents",
                  "cpu",
                  "memory",
                  "gpu",
                  "disk",
                  "network",
                  "music",
                  "volume",
                  "microphone",
                  "activeWindow",
                  "komorebi"
                ]
              },
              "enabled": { "default": true, "type": "boolean" },
              "intervalMs": {
                "default": 2000,
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "format": {
                "default": "label",
                "type": "string",
                "enum": ["compact", "label"]
              },
              "tooltip": { "default": true, "type": "boolean" },
              "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        },
        "center": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": [
                  "separator",
                  "clock",
                  "reminders",
                  "agents",
                  "cpu",
                  "memory",
                  "gpu",
                  "disk",
                  "network",
                  "music",
                  "volume",
                  "microphone",
                  "activeWindow",
                  "komorebi"
                ]
              },
              "enabled": { "default": true, "type": "boolean" },
              "intervalMs": {
                "default": 2000,
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "format": {
                "default": "label",
                "type": "string",
                "enum": ["compact", "label"]
              },
              "tooltip": { "default": true, "type": "boolean" },
              "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        },
        "right": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": [
                  "separator",
                  "clock",
                  "reminders",
                  "agents",
                  "cpu",
                  "memory",
                  "gpu",
                  "disk",
                  "network",
                  "music",
                  "volume",
                  "microphone",
                  "activeWindow",
                  "komorebi"
                ]
              },
              "enabled": { "default": true, "type": "boolean" },
              "intervalMs": {
                "default": 2000,
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "format": {
                "default": "label",
                "type": "string",
                "enum": ["compact", "label"]
              },
              "tooltip": { "default": true, "type": "boolean" },
              "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": ["left", "center", "right"]
    },
    "layout": {
      "type": "object",
      "properties": {
        "left": { "type": "array", "items": { "type": "string" } },
        "center": { "type": "array", "items": { "type": "string" } },
        "right": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["left", "center", "right"]
    },
    "monitors": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "layout": {
            "type": "object",
            "properties": {
              "left": { "type": "array", "items": { "type": "string" } },
              "center": { "type": "array", "items": { "type": "string" } },
              "right": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["left", "center", "right"]
          },
          "position": { "type": "string", "enum": ["top", "bottom"] },
          "height": { "type": "integer", "minimum": 28, "maximum": 80 },
          "cornerRadius": { "type": "number", "minimum": 0, "maximum": 40 },
          "spacing": { "type": "number", "minimum": 0, "maximum": 32 },
          "theme": { "type": "string", "enum": ["system", "dark", "light"] },
          "colorTheme": {
            "type": "string",
            "enum": ["current", "amoled", "nord", "dracula", "catppuccin"]
          },
          "alwaysOnTop": { "type": "boolean" },
          "widgets": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "intervalMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 60000
                },
                "format": { "type": "string", "enum": ["compact", "label"] },
                "tooltip": { "type": "boolean" },
                "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "required": ["version", "bar", "widgets"]
}
