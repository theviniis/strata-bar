{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "number", "const": 2 },
    "weather": {
      "type": "object",
      "properties": {
        "city": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "name": { "type": "string", "minLength": 1, "maxLength": 256 },
                "region": { "type": "string", "maxLength": 256 },
                "country": { "type": "string", "maxLength": 256 },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9/_+-]+$"
                }
              },
              "required": [
                "id",
                "name",
                "region",
                "country",
                "latitude",
                "longitude",
                "timezone"
              ],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "temperatureUnit": {
          "default": "celsius",
          "type": "string",
          "enum": ["celsius", "fahrenheit"]
        },
        "windUnit": {
          "default": "kmh",
          "type": "string",
          "enum": ["kmh", "mph"]
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "unit": {
          "default": "bytes",
          "type": "string",
          "enum": ["bytes", "bits"]
        },
        "probesEnabled": { "default": true, "type": "boolean" },
        "probeTarget": {
          "default": "1.1.1.1",
          "anyOf": [
            {
              "type": "string",
              "format": "ipv4",
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
            },
            {
              "type": "string",
              "format": "ipv6",
              "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
            }
          ]
        }
      }
    },
    "audio": {
      "default": {
        "output": { "source": "windows", "targetIndex": 0 },
        "input": { "source": "windows", "targetIndex": 0 }
      },
      "type": "object",
      "properties": {
        "output": {
          "default": { "source": "windows", "targetIndex": 0 },
          "type": "object",
          "properties": {
            "source": {
              "default": "windows",
              "type": "string",
              "enum": ["windows", "voicemeeter"]
            },
            "targetIndex": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "additionalProperties": false
        },
        "input": {
          "default": { "source": "windows", "targetIndex": 0 },
          "type": "object",
          "properties": {
            "source": {
              "default": "windows",
              "type": "string",
              "enum": ["windows", "voicemeeter"]
            },
            "targetIndex": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "default": {
        "visible": {
          "chatgpt": true,
          "opencode": true,
          "antigravity": true,
          "codex": true
        }
      },
      "type": "object",
      "properties": {
        "visible": {
          "default": {
            "chatgpt": true,
            "opencode": true,
            "antigravity": true,
            "codex": true
          },
          "type": "object",
          "properties": {
            "chatgpt": { "default": true, "type": "boolean" },
            "opencode": { "default": true, "type": "boolean" },
            "antigravity": { "default": true, "type": "boolean" },
            "codex": { "default": true, "type": "boolean" }
          }
        }
      }
    },
    "bar": {
      "type": "object",
      "properties": {
        "enabled": { "default": true, "type": "boolean" },
        "position": {
          "default": "top",
          "type": "string",
          "enum": ["top", "bottom"]
        },
        "height": {
          "default": 36,
          "type": "integer",
          "minimum": 28,
          "maximum": 80
        },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 40 },
        "spacing": {
          "default": 8,
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "separatorMarginX": { "type": "number", "minimum": 0, "maximum": 32 },
        "theme": {
          "default": "system",
          "type": "string",
          "enum": ["system", "dark", "light"]
        },
        "reduceMotion": { "default": false, "type": "boolean" },
        "colorTheme": {
          "default": "current",
          "type": "string",
          "enum": ["current", "amoled", "nord", "dracula", "catppuccin"]
        }
      }
    },
    "widgets": {
      "type": "object",
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": [
                  "separator",
                  "clock",
                  "weather",
                  "reminders",
                  "agents",
                  "cpu",
                  "memory",
                  "gpu",
                  "disk",
                  "network",
                  "music",
                  "mediaSpectrum",
                  "volume",
                  "microphone",
                  "activeWindow",
                  "workspaces"
                ]
              },
              "enabled": { "default": true, "type": "boolean" },
              "intervalMs": {
                "default": 2000,
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "format": {
                "default": "label",
                "type": "string",
                "enum": ["compact", "label"]
              },
              "tooltip": { "default": true, "type": "boolean" },
              "workspaceSource": {
                "type": "string",
                "enum": ["komorebi", "windows"]
              },
              "showUsage": { "type": "boolean" },
              "showTemperature": { "type": "boolean" },
              "networkDirection": {
                "type": "string",
                "enum": ["both", "download", "upload"]
              },
              "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        },
        "center": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": [
                  "separator",
                  "clock",
                  "weather",
                  "reminders",
                  "agents",
                  "cpu",
                  "memory",
                  "gpu",
                  "disk",
                  "network",
                  "music",
                  "mediaSpectrum",
                  "volume",
                  "microphone",
                  "activeWindow",
                  "workspaces"
                ]
              },
              "enabled": { "default": true, "type": "boolean" },
              "intervalMs": {
                "default": 2000,
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "format": {
                "default": "label",
                "type": "string",
                "enum": ["compact", "label"]
              },
              "tooltip": { "default": true, "type": "boolean" },
              "workspaceSource": {
                "type": "string",
                "enum": ["komorebi", "windows"]
              },
              "showUsage": { "type": "boolean" },
              "showTemperature": { "type": "boolean" },
              "networkDirection": {
                "type": "string",
                "enum": ["both", "download", "upload"]
              },
              "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        },
        "right": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": [
                  "separator",
                  "clock",
                  "weather",
                  "reminders",
                  "agents",
                  "cpu",
                  "memory",
                  "gpu",
                  "disk",
                  "network",
                  "music",
                  "mediaSpectrum",
                  "volume",
                  "microphone",
                  "activeWindow",
                  "workspaces"
                ]
              },
              "enabled": { "default": true, "type": "boolean" },
              "intervalMs": {
                "default": 2000,
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "format": {
                "default": "label",
                "type": "string",
                "enum": ["compact", "label"]
              },
              "tooltip": { "default": true, "type": "boolean" },
              "workspaceSource": {
                "type": "string",
                "enum": ["komorebi", "windows"]
              },
              "showUsage": { "type": "boolean" },
              "showTemperature": { "type": "boolean" },
              "networkDirection": {
                "type": "string",
                "enum": ["both", "download", "upload"]
              },
              "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": ["left", "center", "right"]
    },
    "layout": {
      "type": "object",
      "properties": {
        "left": { "type": "array", "items": { "type": "string" } },
        "center": { "type": "array", "items": { "type": "string" } },
        "right": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["left", "center", "right"]
    },
    "monitors": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "layout": {
            "type": "object",
            "properties": {
              "left": { "type": "array", "items": { "type": "string" } },
              "center": { "type": "array", "items": { "type": "string" } },
              "right": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["left", "center", "right"]
          },
          "position": { "type": "string", "enum": ["top", "bottom"] },
          "height": { "type": "integer", "minimum": 28, "maximum": 80 },
          "cornerRadius": { "type": "number", "minimum": 0, "maximum": 40 },
          "spacing": { "type": "number", "minimum": 0, "maximum": 32 },
          "theme": { "type": "string", "enum": ["system", "dark", "light"] },
          "colorTheme": {
            "type": "string",
            "enum": ["current", "amoled", "nord", "dracula", "catppuccin"]
          },
          "widgets": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "intervalMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 60000
                },
                "format": { "type": "string", "enum": ["compact", "label"] },
                "tooltip": { "type": "boolean" },
                "workspaceSource": {
                  "type": "string",
                  "enum": ["komorebi", "windows"]
                },
                "networkDirection": {
                  "type": "string",
                  "enum": ["both", "download", "upload"]
                },
                "showUsage": { "type": "boolean" },
                "showTemperature": { "type": "boolean" },
                "marginX": { "type": "number", "minimum": 0, "maximum": 32 }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "required": ["version", "bar", "widgets"]
}
