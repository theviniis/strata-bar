{
  "name": "strata-bar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "dev": "pnpm generate:popups && pnpm generate:config-schema && vite --host 127.0.0.1",
    "build": "pnpm generate:popups && pnpm generate:config-schema && vite build",
    "build:desktop": "pnpm exec tauri build --no-bundle",
    "test": "pnpm generate:popups && pnpm generate:config-schema && vitest run",
    "lint": "pnpm generate:popups && pnpm generate:config-schema && eslint .",
    "lint:fix": "pnpm generate:popups && pnpm generate:config-schema && eslint . --fix",
    "typecheck": "pnpm generate:popups && pnpm generate:config-schema && tsc -b",
    "check": "pnpm generate:popups && pnpm generate:config-schema && prettier --check . && eslint . && tsc -b && vitest run",
    "desktop": "powershell -NoProfile -File scripts/check-desktop.ps1 && tauri dev",
    "package:windows": "tauri build",
    "format": "pnpm generate:popups && pnpm generate:config-schema && prettier --write .",
    "format:check": "pnpm generate:popups && pnpm generate:config-schema && prettier --check .",
    "generate:config-schema": "node --experimental-strip-types scripts/generate-config-schema.ts",
    "generate:popups": "node --experimental-strip-types scripts/generate-popups.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@tanstack/react-query": "^5.104.4",
    "@tauri-apps/api": "^2.8.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.4.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "react-is": "18.3.1",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <13.0.0",
      "onFail": "error"
    }
  }
}
